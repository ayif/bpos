# Postgres
POSTGRES_USER=bpos
POSTGRES_PASSWORD=bpos_secret
POSTGRES_DB=bpos
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# Backend
BACKEND_PORT=4000
NODE_ENV=development
JWT_SECRET=change_me_super_secret
JWT_EXPIRES_IN=8h
CORS_ORIGIN=http://localhost:3000

# PPOB - Digiflazz (mock by default, set DIGIFLAZZ_MODE=live to call real API)
DIGIFLAZZ_MODE=mock
DIGIFLAZZ_USERNAME=
DIGIFLAZZ_API_KEY=
# Set true with sandbox/developer credentials so live-mode calls don't touch real balance.
DIGIFLAZZ_TESTING=false
# Shared secret for the Digiflazz callback URL (https://<host>/api/ppob/callback?token=...).
# Required (any random string) before the callback endpoint will accept requests.
DIGIFLAZZ_CALLBACK_TOKEN=

# Frontend
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api
